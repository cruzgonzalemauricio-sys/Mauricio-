<section class="py-16 sm:py-24">
  <div class="container-brand">
    <div class="max-w-xl mx-auto text-center mb-12">
      <p class="eyebrow mb-4">Buscar</p>
      <h1 class="font-serif text-3xl sm:text-4xl text-ink mb-6">¿Qué estás buscando?</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="creme-search-form">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Buscar arneses, colores..." class="creme-select" style="width:100%;">
        <button type="submit" class="btn-primary mt-4">Buscar</button>
      </form>
    </div>

    {% if search.performed %}
      {% if search.results_count > 0 %}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-7">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              {% render 'product-card', product: item %}
            {% else %}
              <a href="{{ item.url }}" class="block p-6 rounded-2xl bg-cream-soft shadow-card">
                <h3 class="font-serif text-lg text-ink">{{ item.title }}</h3>
                <p class="mt-2 text-sm text-ink-soft">{{ item.content | strip_html | truncatewords: 20 }}</p>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% else %}
        <p class="text-center text-ink-soft">No hemos encontrado resultados para "{{ search.terms }}".</p>
      {% endif %}
    {% endif %}
  </div>
</section>

{% schema %}
{ "name": "Búsqueda", "settings": [] }
{% endschema %}

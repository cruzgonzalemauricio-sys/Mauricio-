<section class="py-16 sm:py-24">
  <div class="container-brand">
    <h1 class="font-serif text-3xl sm:text-4xl text-ink mb-10 text-center">Colecciones</h1>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {% for collection in collections %}
        <a href="{{ collection.url }}" class="block group">
          <div class="aspect-[4/3] overflow-hidden rounded-2xl mb-4">
            {% if collection.image %}
              <img src="{{ collection.image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" width="600" height="450" loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105">
            {% endif %}
          </div>
          <h2 class="font-serif text-lg text-ink">{{ collection.title }}</h2>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Lista de colecciones", "settings": [] }
{% endschema %}

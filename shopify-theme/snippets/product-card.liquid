{%- comment -%} Usage: {% render 'product-card', product: product, delay: 0 %} {%- endcomment -%}

<div class="group fade-up" style="transition-delay: {{ delay | default: 0 }}ms">
  <a href="{{ product.url }}" class="relative block overflow-hidden rounded-[1.75rem] bg-cream-soft shadow-card">
    <div class="aspect-[4/5] overflow-hidden">
      {% if product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 800 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="800" height="1000"
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06]"
        >
      {% endif %}
      {% if product.compare_at_price > product.price %}
        <span class="creme-badge">Oferta</span>
      {% endif %}
    </div>
    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/70 via-ink/10 to-transparent p-5 pt-16 opacity-0 group-hover:opacity-100 transition-opacity duration-500">
      <span class="text-cream-soft text-xs tracking-wide">{{ product.price | money }}</span>
    </div>
  </a>

  <div class="mt-5 flex items-start justify-between gap-3">
    <div>
      <h3 class="font-serif text-xl text-ink">
        <a href="{{ product.url }}">{{ product.title }}</a>
      </h3>
      <p class="mt-1.5 text-[13px] leading-relaxed text-ink-soft max-w-[26ch]">
        {{ product.description | strip_html | truncatewords: 16 }}
      </p>
    </div>
  </div>

  <div class="mt-4 flex items-center justify-between">
    <span class="text-sm text-ink">
      {{ product.price | money }}
      {% if product.compare_at_price > product.price %}
        <s class="text-ink-soft ml-1">{{ product.compare_at_price | money }}</s>
      {% endif %}
    </span>
    <a href="{{ product.url }}" class="text-[13px] font-medium text-ink border-b border-camel-deep/60 hover:border-ink transition-colors">
      Ver producto
    </a>
  </div>
</div>

<section class="py-16 sm:py-24">
  <div class="container-brand max-w-md mx-auto">
    <h1 class="font-serif text-3xl text-ink text-center mb-10">Crear cuenta</h1>

    {% form 'create_customer' %}
      {% if form.errors %}
        <p class="text-sm text-red-700 mb-4">{{ form.errors | default_errors }}</p>
      {% endif %}

      <div class="creme-option">
        <label for="FirstName">Nombre</label>
        <input type="text" name="customer[first_name]" id="FirstName" class="creme-select" autocomplete="given-name">
      </div>
      <div class="creme-option">
        <label for="LastName">Apellidos</label>
        <input type="text" name="customer[last_name]" id="LastName" class="creme-select" autocomplete="family-name">
      </div>
      <div class="creme-option">
        <label for="RegisterEmail">Email</label>
        <input type="email" name="customer[email]" id="RegisterEmail" class="creme-select" required autocomplete="email">
      </div>
      <div class="creme-option">
        <label for="RegisterPassword">Contraseña</label>
        <input type="password" name="customer[password]" id="RegisterPassword" class="creme-select" required autocomplete="new-password">
      </div>

      <button type="submit" class="btn-primary w-full mt-4">Crear cuenta</button>

      <p class="mt-6 text-center text-sm text-ink-soft">
        ¿Ya tienes cuenta? <a href="{{ routes.account_login_url }}" class="underline">Iniciar sesión</a>
      </p>
    {% endform %}
  </div>
</section>

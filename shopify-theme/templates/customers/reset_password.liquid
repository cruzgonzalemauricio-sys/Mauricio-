<section class="py-16 sm:py-24">
  <div class="container-brand max-w-md mx-auto">
    <h1 class="font-serif text-3xl text-ink text-center mb-10">Restablecer contraseña</h1>
    {% form 'reset_customer_password' %}
      {% if form.errors %}
        <p class="text-sm text-red-700 mb-4">{{ form.errors | default_errors }}</p>
      {% endif %}
      <div class="creme-option">
        <label for="ResetPassword">Nueva contraseña</label>
        <input type="password" name="customer[password]" id="ResetPassword" class="creme-select" required autocomplete="new-password">
      </div>
      <div class="creme-option">
        <label for="ResetPasswordConfirmation">Confirmar contraseña</label>
        <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirmation" class="creme-select" required autocomplete="new-password">
      </div>
      <button type="submit" class="btn-primary w-full mt-4">Guardar contraseña</button>
    {% endform %}
  </div>
</section>

<section class="py-16 sm:py-24">
  <div class="container-brand">
    <div class="mb-12 text-center">
      <p class="eyebrow mb-4">Colección</p>
      <h1 class="font-serif text-3xl sm:text-4xl text-ink">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <div class="mt-4 max-w-xl mx-auto text-sm leading-relaxed text-ink-soft">{{ collection.description }}</div>
      {% endif %}
    </div>

    {% paginate collection.products by 12 %}
      {% if collection.products.size > 0 %}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 sm:gap-7">
          {% for product in collection.products %}
            {% render 'product-card', product: product, delay: forloop.index0 | times: 80 %}
          {% endfor %}
        </div>
      {% else %}
        <p class="text-center text-ink-soft">Todavía no hay productos en esta colección.</p>
      {% endif %}

      {% if paginate.pages > 1 %}
        <nav class="creme-pagination" aria-label="Paginación">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}">&larr; Anterior</a>
          {% endif %}
          <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}">Siguiente &rarr;</a>
          {% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Colección",
  "settings": []
}
{% endschema %}

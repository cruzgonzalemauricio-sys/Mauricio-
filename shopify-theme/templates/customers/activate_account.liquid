<section class="py-16 sm:py-24">
  <div class="container-brand max-w-md mx-auto">
    <h1 class="font-serif text-3xl text-ink text-center mb-10">Activar cuenta</h1>
    {% form 'activate_customer_password' %}
      {% if form.errors %}
        <p class="text-sm text-red-700 mb-4">{{ form.errors | default_errors }}</p>
      {% endif %}
      <div class="creme-option">
        <label for="ActivatePassword">Contraseña</label>
        <input type="password" name="customer[password]" id="ActivatePassword" class="creme-select" required autocomplete="new-password">
      </div>
      <div class="creme-option">
        <label for="ActivatePasswordConfirmation">Confirmar contraseña</label>
        <input type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirmation" class="creme-select" required autocomplete="new-password">
      </div>
      <button type="submit" name="commit" class="btn-primary w-full mt-4">Activar cuenta</button>
    {% endform %}
  </div>
</section>

<section class="py-20 sm:py-28">
  <div class="container-brand">
    <div class="text-center max-w-xl mx-auto mb-12 fade-up">
      <p class="eyebrow mb-4">{{ section.settings.eyebrow }}</p>
      <h2 class="font-serif text-3xl sm:text-4xl text-ink">{{ section.settings.heading }}</h2>
      <p class="mt-5 text-[15px] leading-relaxed text-ink-soft">{{ section.settings.body }}</p>
      {% if section.settings.instagram_handle != blank %}
        <a href="https://instagram.com/{{ section.settings.instagram_handle | remove: '@' }}" target="_blank" rel="noopener" class="mt-4 inline-block text-sm font-medium text-camel-deep border-b border-camel-deep/50 hover:border-camel-deep">
          @{{ section.settings.instagram_handle | remove: '@' }}
        </a>
      {% endif %}
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
      {% for block in section.blocks %}
        <div class="group relative aspect-square overflow-hidden rounded-xl fade-up" style="transition-delay: {{ forloop.index0 | times: 60 }}ms" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 500 }}"
              alt="Momento compartido por la comunidad"
              width="500" height="500"
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
            >
          {% else %}
            {% case forloop.index0 %}
              {% when 0 %}{% assign fallback_image = 'dog-portrait-plaid.jpg' %}
              {% when 1 %}{% assign fallback_image = 'product-tartan-set.jpg' %}
              {% when 2 %}{% assign fallback_image = 'dog-coffee-companion.jpg' %}
              {% when 3 %}{% assign fallback_image = 'kitchen-family.jpg' %}
              {% when 4 %}{% assign fallback_image = 'dog-city-walk.jpg' %}
              {% when 5 %}{% assign fallback_image = 'product-olive-stool.jpg' %}
              {% when 6 %}{% assign fallback_image = 'dog-home-counter.jpg' %}
              {% else %}{% assign fallback_image = 'product-olive-macro.jpg' %}
            {% endcase %}
            <img
              src="{{ fallback_image | asset_url }}"
              alt="Momento compartido por la comunidad"
              width="500" height="500"
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
            >
          {% endif %}
          <div class="absolute inset-0 flex items-center justify-center gap-1.5 bg-ink/0 text-cream-soft opacity-0 transition-all duration-300 group-hover:bg-ink/40 group-hover:opacity-100">
            {% render 'icon', name: 'heart' %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comunidad Instagram",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Comunidad" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "#UnoMásDeLaFamilia" },
    { "type": "textarea", "id": "body", "label": "Texto", "default": "Cada semana compartimos los momentos de las familias CRÈME. Etiquetanos en tus fotos para formar parte de esta comunidad." },
    { "type": "text", "id": "instagram_handle", "label": "Usuario de Instagram", "default": "cremeoriginal" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Foto",
      "settings": [{ "type": "image_picker", "id": "image", "label": "Imagen" }]
    }
  ],
  "default": {
    "blocks": [
      { "type": "photo", "settings": {} },
      { "type": "photo", "settings": {} },
      { "type": "photo", "settings": {} },
      { "type": "photo", "settings": {} },
      { "type": "photo", "settings": {} },
      { "type": "photo", "settings": {} },
      { "type": "photo", "settings": {} },
      { "type": "photo", "settings": {} }
    ]
  }
}
{% endschema %}

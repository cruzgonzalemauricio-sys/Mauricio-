<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="UTF-8" />
    <link rel="canonical" href="{{ canonical_url }}" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#F3EEE2" />
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <title>
      {{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags }}"{% endif %}{% if current_page != 1 %} &ndash; Página {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>

    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96 }}">
    {% else %}
      <link rel="icon" type="image/png" href="{{ 'creme-logo-circle.png' | asset_url }}">
    {% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {{ content_for_header }}

    <link rel="stylesheet" href="{{ 'creme-base.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'creme-theme.css' | asset_url }}">
  </head>

  <body class="min-h-screen bg-cream text-ink font-sans">
    <a class="skip-to-content-link" href="#MainContent">Saltar al contenido</a>

    {% section 'header' %}

    <main id="MainContent">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <script src="{{ 'creme-theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>

<section class="py-16 sm:py-24">
  <div class="container-brand">
    <h1 class="font-serif text-3xl sm:text-4xl text-ink mb-10">Tu carrito</h1>

    {% if cart.item_count == 0 %}
      <p class="text-ink-soft">Tu carrito está vacío por ahora.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn-primary mt-6 inline-flex">Ver arneses</a>
    {% else %}
      {% form 'cart', cart, class: 'creme-cart-form' %}
        <div class="creme-cart-table">
          {% for item in cart.items %}
            <div class="creme-cart-row">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="100" class="creme-cart-thumb">
              {% endif %}
              <div class="creme-cart-info">
                <a href="{{ item.url }}" class="font-serif text-lg text-ink">{{ item.product.title }}</a>
                {% unless item.variant.title == 'Default Title' %}
                  <p class="text-xs text-ink-soft mt-1">{{ item.variant.title }}</p>
                {% endunless %}
                <p class="text-sm text-ink mt-2">{{ item.final_price | money }}</p>
              </div>
              <input type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" class="creme-qty">
              <p class="creme-cart-line-total">{{ item.final_line_price | money }}</p>
            </div>
          {% endfor %}
        </div>

        <div class="creme-cart-summary">
          <p class="font-serif text-xl text-ink">Total: {{ cart.total_price | money }}</p>
          <div class="flex gap-3 mt-4">
            <button type="submit" name="update" class="btn-secondary">Actualizar carrito</button>
            <button type="submit" name="checkout" class="btn-primary">Finalizar compra</button>
          </div>
        </div>
      {% endform %}
    {% endif %}
  </div>
</section>

{% schema %}
{ "name": "Carrito", "settings": [] }
{% endschema %}
